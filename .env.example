NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/patino_schools_dev
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3001,http://localhost:3002
STAFF_INVITE_BASE_URL=http://localhost:3002

# Gmail SMTP — leave unset to log invite emails instead of sending them.
# GMAIL_APP_PASSWORD is a 16-character Google "App Password" (Account > Security > 2-Step
# Verification > App passwords; requires 2FA enabled), not your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
