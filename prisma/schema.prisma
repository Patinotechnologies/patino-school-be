datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum SchoolLevel {
  nursery
  primary
  secondary

  @@map("school_level")
}

enum StaffRole {
  school_admin
  bursar
  class_teacher
  subject_teacher

  @@map("staff_role")
}

enum GuardianRelationship {
  mother
  father
  guardian

  @@map("guardian_relationship")
}

enum PupilStatus {
  active
  suspended

  @@map("pupil_status")
}

enum AttendanceStatus {
  present
  absent
  late

  @@map("attendance_status")
}

enum Term {
  first
  second
  third

  @@map("term")
}

enum FeeInvoiceStatus {
  unpaid
  partial
  paid

  @@map("fee_invoice_status")
}

/** Logged-out tokens (admin or staff) — checked by jti on every authenticated request so a logged-out token can't be reused before it naturally expires. */
model RevokedToken {
  id        String   @id @default(uuid()) @db.Uuid
  jti       String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("revoked_tokens")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  fullName     String   @map("full_name")
  phone        String?
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedOrganizations Organization[] @relation("OrganizationOwner")

  @@map("users")
}

model Organization {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  phone       String?
  email       String?
  onboardedAt DateTime? @map("onboarded_at")
  ownerId     String    @map("owner_id") @db.Uuid
  owner       User      @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  schools                 School[]
  staff                   Staff[]
  staffAttendanceSettings StaffAttendanceSettings?

  @@map("organizations")
}

model School {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  level          SchoolLevel
  address        String?
  onboardedAt    DateTime?    @map("onboarded_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  classes       Class[]
  pupils        Pupil[]
  feeStructures FeeStructure[]
  subjects      Subject[]

  @@index([organizationId])
  @@map("schools")
}

model Staff {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fullName             String       @map("full_name")
  email                String       @unique
  phone                String?
  role                 StaffRole
  active               Boolean      @default(true)
  passwordHash         String?      @map("password_hash")
  inviteToken          String?      @unique @map("invite_token")
  inviteTokenExpiresAt DateTime?    @map("invite_token_expires_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  classesTaught          Class[]
  subjectsTaught         ClassSubject[]
  staffAttendanceRecords StaffAttendanceRecord[]

  @@index([organizationId])
  @@map("staff")
}

/** One set of check-in rules per organization — staff aren't tied to a single school. */
model StaffAttendanceSettings {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @unique @map("organization_id") @db.Uuid
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkInTime        String       @map("check_in_time")
  gracePeriodMinutes Int          @default(15) @map("grace_period_minutes")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@map("staff_attendance_settings")
}

/** One check-in per staff per day — a missing row for a given date means absent. */
model StaffAttendanceRecord {
  id        String   @id @default(uuid()) @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  checkInAt DateTime @map("check_in_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([staffId, date])
  @@index([date])
  @@map("staff_attendance_records")
}

model Class {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name           String
  classTeacherId String?  @map("class_teacher_id") @db.Uuid
  classTeacher   Staff?   @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  pupils             Pupil[]
  attendanceSessions AttendanceSession[]
  examScores         ExamScore[]
  feeInvoices        FeeInvoice[]
  classSubjects      ClassSubject[]

  @@index([schoolId])
  @@map("classes")
}

model Subject {
  id                 String   @id @default(uuid()) @db.Uuid
  schoolId           String   @map("school_id") @db.Uuid
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name               String
  testMaxScore       Float    @default(0) @map("test_max_score")
  assignmentMaxScore Float    @default(0) @map("assignment_max_score")
  examMaxScore       Float    @default(0) @map("exam_max_score")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  classSubjects      ClassSubject[]
  examScores         ExamScore[]
  attendanceSessions AttendanceSession[]

  @@unique([schoolId, name])
  @@map("subjects")
}

model ClassSubject {
  id               String   @id @default(uuid()) @db.Uuid
  classId          String   @map("class_id") @db.Uuid
  class            Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId        String   @map("subject_id") @db.Uuid
  subject          Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectTeacherId String?  @map("subject_teacher_id") @db.Uuid
  subjectTeacher   Staff?   @relation(fields: [subjectTeacherId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

model Pupil {
  id                   String               @id @default(uuid()) @db.Uuid
  schoolId             String               @map("school_id") @db.Uuid
  school               School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId              String?              @map("class_id") @db.Uuid
  class                Class?               @relation(fields: [classId], references: [id], onDelete: SetNull)
  fullName             String               @map("full_name")
  dateOfBirth          DateTime             @map("date_of_birth") @db.Date
  guardianName         String               @map("guardian_name")
  guardianPhone        String               @map("guardian_phone")
  guardianRelationship GuardianRelationship @map("guardian_relationship")
  address              String?
  status               PupilStatus          @default(active)
  suspensionReason     String?              @map("suspension_reason")
  deletedAt            DateTime?            @map("deleted_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  attendanceRecords AttendanceRecord[]
  examScores        ExamScore[]
  feeInvoices       FeeInvoice[]

  @@index([schoolId])
  @@index([classId])
  @@map("pupils")
}

/**
 * One "attendance was taken" event — for a whole class, a subject period, or a named extra activity.
 */
model AttendanceSession {
  id        String   @id @default(uuid()) @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String?  @map("subject_id") @db.Uuid
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  /**
   * Free-text label for a non-subject session (e.g. "Sports Day") — independent of `subject`, which is only set when a real Subject was picked.
   */
  activity  String?
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  records AttendanceRecord[]

  @@index([classId, date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String            @id @default(uuid()) @db.Uuid
  sessionId String            @map("session_id") @db.Uuid
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pupilId   String            @map("pupil_id") @db.Uuid
  pupil     Pupil             @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  status    AttendanceStatus
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@unique([sessionId, pupilId])
  @@map("attendance_records")
}

model ExamScore {
  id        String   @id @default(uuid()) @db.Uuid
  pupilId   String   @map("pupil_id") @db.Uuid
  pupil     Pupil    @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  classId   String   @map("class_id") @db.Uuid
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String   @map("subject_id") @db.Uuid
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  term      Term
  session   String
  score     Float
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([pupilId, subjectId, term, session])
  @@index([classId, term, session])
  @@map("exam_scores")
}

model FeeStructure {
  id        String      @id @default(uuid()) @db.Uuid
  schoolId  String      @map("school_id") @db.Uuid
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  level     SchoolLevel
  term      Term
  session   String
  amount    Float
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@unique([schoolId, level, term, session])
  @@map("fee_structures")
}

model FeeInvoice {
  id         String           @id @default(uuid()) @db.Uuid
  pupilId    String           @map("pupil_id") @db.Uuid
  pupil      Pupil            @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  classId    String           @map("class_id") @db.Uuid
  class      Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  term       Term
  session    String
  amount     Float
  amountPaid Float            @default(0) @map("amount_paid")
  status     FeeInvoiceStatus @default(unpaid)
  dueDate    DateTime?        @map("due_date") @db.Date
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  payments FeePayment[]

  @@unique([pupilId, term, session])
  @@index([classId, term, session])
  @@map("fee_invoices")
}

model FeePayment {
  id        String     @id @default(uuid()) @db.Uuid
  invoiceId String     @map("invoice_id") @db.Uuid
  invoice   FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  paidAt    DateTime   @default(now()) @map("paid_at")
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([invoiceId])
  @@map("fee_payments")
}
