{
  "name": "patino-schools-be",
  "version": "1.0.0",
  "description": "This is the backend that powers the patino schools.",
  "main": "dist/app.js",
  "repository": "https://github.com/Patinotechnologies/patino-school-be.git",
  "author": "Godwin Okhakhayo",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon",
    "migrate:make": "tsx ./node_modules/knex/bin/cli.js migrate:make -x ts",
    "migrate:latest": "tsx ./node_modules/knex/bin/cli.js migrate:latest",
    "migrate:rollback": "tsx ./node_modules/knex/bin/cli.js migrate:rollback",
    "seed:make": "tsx ./node_modules/knex/bin/cli.js seed:make -x ts",
    "seed:run": "tsx ./node_modules/knex/bin/cli.js seed:run"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
